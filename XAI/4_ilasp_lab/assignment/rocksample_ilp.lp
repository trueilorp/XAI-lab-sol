#program step(t).
% TODO
0{east(t);
 west(t);
 north(t); 
 south(t); 
 sample(R,t) : rock(R), loc(R, (X,Y)), at((X,Y), t), good(R), not sampled(R,t)
 }1.

%preconditions
%Robot at (X,Y) can move east only if (X+1,Y) is a valid cell
:- east(t), at((X,Y), t), not cell((X+1, Y)).
:- north(t), at((X,Y),t), not cell ((X,Y+1)).
:- south(t), at((X,Y),t), not cell ((X,Y-1)).
:- west(t), at((X,Y),t), not cell ((X-1,Y)).

%:- sample(R,t), loc(R, (X,Y)), not at((X,Y), t).
%:- sample(R,t), not good(R).
%:- sample(R,t), sampled(R,t). 

%effects
% If robot moves east at time t, it will be at (X+1,Y) at time t+1
at((X+1, Y), t+1) :- east(t), at((X,Y), t).
at((X-1, Y), t+1) :- west(t), at((X,Y), t).
at((X, Y+1), t+1) :- north(t), at((X,Y), t).
at((X, Y-1), t+1) :- south(t), at((X,Y), t).
%frame axiom
at((X,Y), t+1) :- at((X,Y), t), not east(t), not west(t), not north(t), not south(t). %if robot doesnt move it stays in same position

sampled(R,t+1) :- sample(R,t).
sampled(R, t+1) :- sampled(R, t). % if i sampled a rock, it will stay sampled in the future

#program check(t).
%:- query(t), t<2.
:- query(t), not sampled(R,t), good(R).



