dist(R, D) :- rock(R), loc(R, (RX, RY)), at((AX, AY), 1), 
              D = |RX - AX| + |RY - AY|.

loc(0, (2,2)).
loc(1, (5,2)).
loc(2, (2,4)).
loc(3, (9,9)).

at((0,0), 1).

